# Butsó environment variables.
# Copy this file to .env.local (or .env) and fill in the values. One NAME=value per line,
# no spaces around "=", no quotes. Never commit the real file (it is in .gitignore).
#
# These are the ONLY variables the code reads. All four start with NEXT_PUBLIC_, which means
# they are built into the app and visible in the browser: that is expected for these values.
# Never put a secret (like a Supabase service_role key) in a NEXT_PUBLIC_ variable.
# On Vercel, set them under Project -> Settings -> Environment Variables, then redeploy.

# Supabase -> your project -> Project Settings -> API (or Data API) -> Project URL
# Looks like: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase -> same page -> Project API keys -> "anon" / "public" key (a long eyJ... string).
# NOT the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The live address of the site, https, no trailing slash. Used for share links, WhatsApp
# previews, the sitemap and robots.txt. Locally you can leave it empty: it falls back to
# Vercel's production address, then to http://localhost:3000.
# Looks like: https://butso.ng
NEXT_PUBLIC_SITE_URL=

# Cloudinary -> Settings -> Upload -> Upload presets -> the name of an UNSIGNED preset
# on the "kqgcosmz" cloud (the cloud name is set in lib/cloudinary.ts, not here).
# Without it, photo uploads are switched off. See the README for the preset settings.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Set automatically, do not add yourself:
#   NODE_ENV                        set by Next.js (development / production)
#   VERCEL_PROJECT_PRODUCTION_URL   set by Vercel; used when NEXT_PUBLIC_SITE_URL is empty
